{% import 'template_macros.j2' as template_macros %}

{%- set storage_target_name = item -%}
# {{ storage_target_name }} - BeeGFS HA E-Series storage target resource

# Review all comments and update with all expected values. All capitalized words in angled brackets must be updated.

{% set storage_id = storage_target_name | regex_search('\d+$') | int -%}

{%- set protocol = eseries_storage_settings['eseries_initiator_protocol'] %}
{%- set storage_mgmt_ip_start = eseries_storage_settings['mgmt_ip_start'] %}

eseries_system_name: {{ storage_target_name }}

# Management IP of one of the controllers in the array.
{% set mgmt_ip = hostvars[storage_target_name]['ansible_host'] %}
{% if mgmt_ip is defined -%}
ansible_host: {{ mgmt_ip -}}
{% elif storage_mgmt_ip_start is defined -%}
ansible_host: {{ template_macros.calc_ip_address(storage_mgmt_ip_start['controller_a'], storage_id) }}
{%- else %}
ansible_host: <ADDRESS>
{% endif %}


{% raw -%}
# Storage system's admin password.
eseries_system_password: "{{ eseries_password }}"

# Verify that this is the correct SANtricity Web Services REST API.
eseries_system_api_url: "https://{{ ansible_host }}:8443/devmgr/v2/"
{% endraw %}

# Whether to validate SSL certificates.
eseries_validate_certs: false


# Protocol utilized for communication between the E-series array and the file node.
# Choices: fc, ib_iser, ib_srp, iscsi, nvme_fc, nvme_ib, nvme_roce
eseries_initiator_protocol: {{ protocol }}

{% if protocol == "fc" %}

# No additional configuration required for FC.
# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- elif protocol == "ib_iser" %}

eseries_controller_ib_iser_port:
  controller_a:    # Ordered list of controller A channel address definition.
    -              # Port IPv4 address for channel 1
    - (...)        # So on and so forth
  controller_b:    # Ordered list of controller B channel address definition.

# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- elif protocol == "ib_srp" %}

# No additional configuration required for SRP. 
# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- elif protocol == "iscsi" %}

eseries_controller_iscsi_port:
  controller_a:         # Ordered list of controller A channel definition.
    - state:            # Whether the port should be enabled. Choices: enabled, disabled
      config_method:    # Port configuration method Choices: static, dhcp
      address:          # Port IPv4 address
      gateway:          # Port IPv4 gateway
      subnet_mask:      # Port IPv4 subnet_mask
      mtu:              # Port IPv4 mtu
  controller_b:         # Ordered list of controller B channel definition.
    - (...)             # Same as controller A but for controller B


{%- elif protocol == "nvme_fc" %}

# No additional configuration required for NVMe FC. 
# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- elif protocol == "nvme_ib" %}

{%- include 'eseries_controller_protocol/eseries_controller_nvme_ib_template.j2' %}


{%- elif protocol == "nvme_roce" %}

eseries_controller_nvme_roce_port:
  controller_a:         # Ordered list of controller A channel definition.
    - state:            # Whether the port should be enabled.
      config_method:    # Port configuration method Choices: static, dhcp
      address:          # Port IPv4 address
      subnet_mask:      # Port IPv4 subnet_mask
      gateway:          # Port IPv4 gateway
      mtu:              # Port IPv4 mtu
      speed:            # Port IPv4 speed
  controller_b:         # Ordered list of controller B channel definition.
    - (...)             # Same as controller A but for controller B

# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- elif protocol == "sas" %}

# No additional configuration required for SAS.
# See https://github.com/netappeseries/santricity/blob/master/roles/nar_santricity_host/README.md for all available parameters.


{%- else %}<PROTOCOL>{% endif %} 

# See https://github.com/netappeseries/santricity/blob/master/README.md for all parameters that can be configured on E-Series storage systems.
